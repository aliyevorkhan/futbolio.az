# =============================================================================
# Futbolio — root environment file.
# Copy to `.env` and fill in real values. `.env` is gitignored; this file is
# the only one tracked in git. Every var that can safely stay blank in local
# development says so explicitly below.
#
# docker-compose reads this file via `env_file: .env` for every service, plus
# a handful of ${VAR:-default} fallbacks defined in docker-compose.yml itself.
# =============================================================================

# --- Django core -------------------------------------------------------------
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings

# --- Database (Postgres, run as the `postgres` compose service) -------------
POSTGRES_DB=futbolio
POSTGRES_USER=futbolio
POSTGRES_PASSWORD=futbolio-dev-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://futbolio:futbolio-dev-password@postgres:5432/futbolio

# --- Redis (Celery broker/result backend + DRF throttle cache) --------------
REDIS_URL=redis://redis:6379/0

# --- Cross-origin / cookies ---------------------------------------------------
# In production: FRONTEND_URL=https://futbolio.az, backend served from
# https://api.futbolio.az, SESSION_COOKIE_DOMAIN=.futbolio.az so the admin
# session cookie is shared across both subdomains (same registrable domain).
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=False

# --- Object storage (S3-compatible) ------------------------------------------
# Local dev: Garage (compose service below, see docker/garage/README.md for
# the one-time bootstrap), path-style addressing. The access key/secret here
# must match whatever you `garage key import` during that bootstrap.
# Production: Hetzner Object Storage — same vars, different endpoint/region
# and AWS_S3_ADDRESSING_STYLE=virtual. No code change needed to swap.
AWS_ACCESS_KEY_ID=futbolio-app
AWS_SECRET_ACCESS_KEY=change-me-to-a-generated-secret
AWS_S3_BUCKET=futbolio-uploads
AWS_S3_ENDPOINT_URL=http://garage:3900
AWS_S3_REGION_NAME=garage
AWS_S3_ADDRESSING_STYLE=path

# --- ClamAV (antivirus scanning of uploaded files, always on — spec §10.3) ---
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# --- Email (Mailpit locally; a real transactional provider in production) ---
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=Futbolio <no-reply@futbolio.az>

# --- Cloudflare Turnstile (bot protection on public registration) -----------
# Leave both keys blank + TURNSTILE_BYPASS=True for local dev (clearly logged
# as a dev-only bypass). Get real site/secret keys from the Cloudflare
# dashboard before deploying to staging/production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_BYPASS=True

# --- Sentry (error tracking — optional, blank = fully disabled/no-op) -------
SENTRY_DSN=

# --- Admin password policy ----------------------------------------------------
PASSWORD_MIN_LENGTH=12
PASSWORD_HIBP_CHECK_ENABLED=False

# --- File handling tunables ---------------------------------------------------
FILE_PRESIGN_UPLOAD_TTL_SECONDS=600
FILE_PRESIGN_VIEW_TTL_SECONDS=900
FILE_PRESIGN_EXPORT_TTL_SECONDS=604800
FILE_ABANDONED_PURGE_HOURS=24

# --- Retention -----------------------------------------------------------------
APPLICATION_RETENTION_MONTHS_DEFAULT=12
AUDIT_LOG_RETENTION_MONTHS=12

# --- Rate limiting -------------------------------------------------------------
RATE_LIMIT_REGISTRATION_PER_HOUR=5
RATE_LIMIT_UPLOAD_LINK_PER_MINUTE=20

# --- Admin login lockout --------------------------------------------------------
ADMIN_LOGIN_LOCKOUT_THRESHOLD=5
ADMIN_LOGIN_LOCKOUT_MINUTES=15

# --- Notifications --------------------------------------------------------------
# NOTIFICATIONS_BACKEND=console is the default and logs new-registration
# summaries to the backend's stdout. Switch to `telegram` once a bot token
# and chat id exist; until then those two vars can stay blank.
NOTIFICATIONS_BACKEND=console
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Frontend build args / runtime (consumed by the `frontend` service) -----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Fallback only — the real values are served from /api/public/settings/ so the
# site can update them in one place without a redeploy.
NEXT_PUBLIC_WHATSAPP_NUMBER=994558850709
NEXT_PUBLIC_WHATSAPP_DEFAULT_TEXT=Salam, oyunçu lazımdır
# Blank = analytics abstraction no-ops (console-only in dev).
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_SITE_ID=
NEXT_PUBLIC_SENTRY_DSN=
# Public Turnstile site key — safe to expose client-side. Blank in dev (no
# widget renders; backend's TURNSTILE_BYPASS=True accepts the empty token).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
