# Copy to .env.local for local development.

# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public site URL (used for metadata/sitemap/robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp link fallback defaults. In production these are also served by
# the public settings API (GET /api/public/settings/) and that response
# should always be treated as the source of truth at runtime; these env
# vars only matter for the Docker build ARGs / local dev fallback.
NEXT_PUBLIC_WHATSAPP_NUMBER=994558850709
NEXT_PUBLIC_WHATSAPP_DEFAULT_TEXT="Salam, oyunçu lazımdır"

# Analytics provider abstraction (see lib/analytics.ts). Leave blank to
# disable analytics entirely (dev default: console.log tracking only).
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_SITE_ID=

# Cloudflare Turnstile site key (public, safe to expose client-side). Leave
# blank in local dev — the registration wizard renders no widget and sends
# an empty turnstile_token, which the backend accepts because
# TURNSTILE_BYPASS=True there. Must be set before deploying to
# staging/production, where the backend's bypass is off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
